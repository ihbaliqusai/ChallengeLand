rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Paid grants and rights have a separate server-only authority. Client
    // snapshots under /users must never be accepted as proof of payment.
    match /commerce_accounts/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;

      match /transactions/{deliveryId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /entitlements/{entitlementId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }
    }

    // Tokens are credentials used only by the backend verifier and RTDN worker.
    match /commerce_purchase_tokens/{deliveryId} {
      allow read, write: if false;
    }

    function nonnegativeInteger(value) {
      return value is int && value >= 0 && value <= 2147483647;
    }

    function publicProfileFieldsAreSafe() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'uid',
        'username',
        'photoUrl',
        'friendCode',
        'createdAt',
        'lastSeenAt',
        'xp',
        'gamesPlayed',
        'wins',
        'losses',
        'draws',
        'abandoned',
        'correctAnswers',
        'wrongAnswers',
        'totalEarnings',
        'onlineWins',
        'trophiesEarned',
        'trophiesLost',
        'blitzFinishes',
        'eliminationWins',
        'survivalWins',
        'seriesWins',
        'teamBattleWins',
        'localTeamsPlayed',
        'offlineBoardPlayed',
        'offlineBoardWins',
        'friendMatchesPlayed',
        'randomMatchesPlayed',
        'bestStreak',
        'bestWinStreak',
        'highestMoney',
        'bestTrophies',
        'trophies',
        'winStreak',
        'lastPrize',
        'level',
        'totalAnswered',
        'accuracy',
        'winPercent',
        'progressionVersion',
        'totalMatches',
        'totalScore',
        'rating'
      ]) &&
        data.uid is string &&
        data.get('username', '') is string &&
        (data.get('photoUrl', null) == null || data.photoUrl is string) &&
        data.get('friendCode', '') is string &&
        (data.get('createdAt', null) == null || data.createdAt is timestamp) &&
        (data.get('lastSeenAt', null) == null || data.lastSeenAt is timestamp) &&
        nonnegativeInteger(data.get('xp', 0)) &&
        nonnegativeInteger(data.get('gamesPlayed', 0)) &&
        nonnegativeInteger(data.get('wins', 0)) &&
        nonnegativeInteger(data.get('losses', 0)) &&
        nonnegativeInteger(data.get('draws', 0)) &&
        nonnegativeInteger(data.get('abandoned', 0)) &&
        nonnegativeInteger(data.get('correctAnswers', 0)) &&
        nonnegativeInteger(data.get('wrongAnswers', 0)) &&
        nonnegativeInteger(data.get('totalEarnings', 0)) &&
        nonnegativeInteger(data.get('onlineWins', 0)) &&
        nonnegativeInteger(data.get('trophiesEarned', 0)) &&
        nonnegativeInteger(data.get('trophiesLost', 0)) &&
        nonnegativeInteger(data.get('blitzFinishes', 0)) &&
        nonnegativeInteger(data.get('eliminationWins', 0)) &&
        nonnegativeInteger(data.get('survivalWins', 0)) &&
        nonnegativeInteger(data.get('seriesWins', 0)) &&
        nonnegativeInteger(data.get('teamBattleWins', 0)) &&
        nonnegativeInteger(data.get('localTeamsPlayed', 0)) &&
        nonnegativeInteger(data.get('offlineBoardPlayed', 0)) &&
        nonnegativeInteger(data.get('offlineBoardWins', 0)) &&
        nonnegativeInteger(data.get('friendMatchesPlayed', 0)) &&
        nonnegativeInteger(data.get('randomMatchesPlayed', 0)) &&
        nonnegativeInteger(data.get('bestStreak', 0)) &&
        nonnegativeInteger(data.get('bestWinStreak', 0)) &&
        nonnegativeInteger(data.get('highestMoney', 0)) &&
        nonnegativeInteger(data.get('bestTrophies', 0)) &&
        nonnegativeInteger(data.get('trophies', 0)) &&
        nonnegativeInteger(data.get('winStreak', 0)) &&
        nonnegativeInteger(data.get('lastPrize', 0)) &&
        nonnegativeInteger(data.get('level', 0)) &&
        nonnegativeInteger(data.get('totalAnswered', 0)) &&
        nonnegativeInteger(data.get('accuracy', 0)) &&
        nonnegativeInteger(data.get('winPercent', 0)) &&
        nonnegativeInteger(data.get('progressionVersion', 0)) &&
        nonnegativeInteger(data.get('totalMatches', 0)) &&
        nonnegativeInteger(data.get('totalScore', 0)) &&
        nonnegativeInteger(data.get('rating', 0)) &&
        data.get('level', 1) >= 1 &&
        data.get('accuracy', 0) <= 100 &&
        data.get('winPercent', 0) <= 100;
    }

    // Integer arithmetic retains its type; a float in any group makes its sum
    // a float. Checking the sum once plus each sign keeps all 72 counters
    // validated within Firestore's 1000-expression budget. Contributions are
    // cumulative int64 checkpoints; displayed account totals use int32 bounds.
    function validContributionGroup0(counters) {
      let value0 = counters.get('xp', 0);
      let value1 = counters.get('gamesPlayed', 0);
      let value2 = counters.get('wins', 0);
      let value3 = counters.get('losses', 0);
      let value4 = counters.get('draws', 0);
      let value5 = counters.get('abandoned', 0);
      let value6 = counters.get('correctAnswers', 0);
      let value7 = counters.get('wrongAnswers', 0);
      let value8 = counters.get('totalEarnings', 0);
      let value9 = counters.get('onlineWins', 0);
      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&
        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;
    }

    function validContributionGroup1(counters) {
      let value0 = counters.get('trophiesEarned', 0);
      let value1 = counters.get('trophiesLost', 0);
      let value2 = counters.get('blitzFinishes', 0);
      let value3 = counters.get('eliminationWins', 0);
      let value4 = counters.get('survivalWins', 0);
      let value5 = counters.get('seriesWins', 0);
      let value6 = counters.get('teamBattleWins', 0);
      let value7 = counters.get('localTeamsPlayed', 0);
      let value8 = counters.get('offlineBoardPlayed', 0);
      let value9 = counters.get('offlineBoardWins', 0);
      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&
        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;
    }

    function validContributionGroup2(counters) {
      let value0 = counters.get('friendMatchesPlayed', 0);
      let value1 = counters.get('randomMatchesPlayed', 0);
      let value2 = counters.get('mode_campaign_games', 0);
      let value3 = counters.get('mode_campaign_wins', 0);
      let value4 = counters.get('mode_campaign_losses', 0);
      let value5 = counters.get('mode_campaign_draws', 0);
      let value6 = counters.get('mode_campaign_abandoned', 0);
      let value7 = counters.get('mode_offline_games', 0);
      let value8 = counters.get('mode_offline_wins', 0);
      let value9 = counters.get('mode_offline_losses', 0);
      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&
        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;
    }

    function validContributionGroup3(counters) {
      let value0 = counters.get('mode_offline_draws', 0);
      let value1 = counters.get('mode_offline_abandoned', 0);
      let value2 = counters.get('mode_local_teams_games', 0);
      let value3 = counters.get('mode_local_teams_wins', 0);
      let value4 = counters.get('mode_local_teams_losses', 0);
      let value5 = counters.get('mode_local_teams_draws', 0);
      let value6 = counters.get('mode_local_teams_abandoned', 0);
      let value7 = counters.get('mode_board_games', 0);
      let value8 = counters.get('mode_board_wins', 0);
      let value9 = counters.get('mode_board_losses', 0);
      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&
        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;
    }

    function validContributionGroup4(counters) {
      let value0 = counters.get('mode_board_draws', 0);
      let value1 = counters.get('mode_board_abandoned', 0);
      let value2 = counters.get('mode_battle_games', 0);
      let value3 = counters.get('mode_battle_wins', 0);
      let value4 = counters.get('mode_battle_losses', 0);
      let value5 = counters.get('mode_battle_draws', 0);
      let value6 = counters.get('mode_battle_abandoned', 0);
      let value7 = counters.get('mode_team_battle_games', 0);
      let value8 = counters.get('mode_team_battle_wins', 0);
      let value9 = counters.get('mode_team_battle_losses', 0);
      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&
        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;
    }

    function validContributionGroup5(counters) {
      let value0 = counters.get('mode_team_battle_draws', 0);
      let value1 = counters.get('mode_team_battle_abandoned', 0);
      let value2 = counters.get('mode_blitz_games', 0);
      let value3 = counters.get('mode_blitz_wins', 0);
      let value4 = counters.get('mode_blitz_losses', 0);
      let value5 = counters.get('mode_blitz_draws', 0);
      let value6 = counters.get('mode_blitz_abandoned', 0);
      let value7 = counters.get('mode_elimination_games', 0);
      let value8 = counters.get('mode_elimination_wins', 0);
      let value9 = counters.get('mode_elimination_losses', 0);
      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&
        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;
    }

    function validContributionGroup6(counters) {
      let value0 = counters.get('mode_elimination_draws', 0);
      let value1 = counters.get('mode_elimination_abandoned', 0);
      let value2 = counters.get('mode_survival_games', 0);
      let value3 = counters.get('mode_survival_wins', 0);
      let value4 = counters.get('mode_survival_losses', 0);
      let value5 = counters.get('mode_survival_draws', 0);
      let value6 = counters.get('mode_survival_abandoned', 0);
      let value7 = counters.get('mode_series_games', 0);
      let value8 = counters.get('mode_series_wins', 0);
      let value9 = counters.get('mode_series_losses', 0);
      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&
        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;
    }

    function validContributionGroup7(counters) {
      let value0 = counters.get('mode_series_draws', 0);
      let value1 = counters.get('mode_series_abandoned', 0);
      return (value0 + value1) is int &&
        value0 >= 0 && value1 >= 0;
    }

    function progressionCheckpointFieldsAreSafe() {
      let data = request.resource.data;
      let counters = data.contributions;
      return data.keys().hasOnly(['contributions', 'updatedAt', 'version']) &&
        data.version == 2 && data.updatedAt is timestamp &&
        counters is map &&
        // Only canonical counters are copied by ProgressionService. Unknown
        // private keys never enter the separately whitelisted public profile.
        counters.keys().size() <= 73 &&
        validContributionGroup0(counters) &&
        validContributionGroup1(counters) &&
        validContributionGroup2(counters) &&
        validContributionGroup3(counters) &&
        validContributionGroup4(counters) &&
        validContributionGroup5(counters) &&
        validContributionGroup6(counters) &&
        validContributionGroup7(counters) &&
        counters.get('trophies', 0) is int &&
        counters.get('trophies', 0) >= -2147483647 &&
        counters.get('trophies', 0) <= 2147483647;
    }

    function campaignLeaderboardFieldsAreSafe(uid) {
      return request.resource.data.keys().hasOnly([
        'uid',
        'displayName',
        'photoUrl',
        'campaignId',
        'stageId',
        'score',
        'stars',
        'money',
        'correctAnswers',
        'timeMs',
        'usedLifelines',
        'assisted',
        'updatedAt'
      ]) &&
      request.resource.data.uid == uid &&
      request.resource.data.uid is string &&
      request.resource.data.displayName is string &&
      request.resource.data.campaignId is string &&
      request.resource.data.stageId is string &&
      request.resource.data.score is int &&
      request.resource.data.score >= 0 &&
      request.resource.data.stars is int &&
      request.resource.data.stars >= 0 &&
      request.resource.data.stars <= 3 &&
      request.resource.data.money is int &&
      request.resource.data.money >= 0 &&
      request.resource.data.correctAnswers is int &&
      request.resource.data.correctAnswers >= 0 &&
      request.resource.data.timeMs is int &&
      request.resource.data.timeMs >= 0 &&
      request.resource.data.usedLifelines is int &&
      request.resource.data.usedLifelines >= 0 &&
      request.resource.data.assisted is bool &&
      (!request.resource.data.keys().hasAny(['photoUrl']) ||
        request.resource.data.photoUrl == null ||
        request.resource.data.photoUrl is string) &&
      (!request.resource.data.keys().hasAny(['updatedAt']) ||
        request.resource.data.updatedAt is timestamp);
    }

    function campaignRewardClaimFieldsAreSafe(uid) {
      return request.resource.data.keys().hasOnly([
        'uid',
        'campaignId',
        'stageId',
        'previousStars',
        'newStars',
        'coins',
        'gems',
        'xp',
        'status',
        'createdAt',
        'claimedAt',
        'updatedAt',
        'attemptId',
        'currencyClaimed',
        'xpClaimed',
        'retryCount'
      ]) &&
      request.resource.data.uid == uid &&
      request.resource.data.uid is string &&
      request.resource.data.campaignId is string &&
      request.resource.data.stageId is string &&
      request.resource.data.previousStars is int &&
      request.resource.data.previousStars >= 0 &&
      request.resource.data.previousStars <= 3 &&
      request.resource.data.newStars is int &&
      request.resource.data.newStars >= 0 &&
      request.resource.data.newStars <= 3 &&
      request.resource.data.coins is int &&
      request.resource.data.coins >= 0 &&
      request.resource.data.gems is int &&
      request.resource.data.gems >= 0 &&
      request.resource.data.xp is int &&
      request.resource.data.xp >= 0 &&
      request.resource.data.status in ['pending', 'claimed', 'failed'] &&
      request.resource.data.attemptId is string &&
      request.resource.data.currencyClaimed is bool &&
      request.resource.data.xpClaimed is bool &&
      request.resource.data.retryCount is int &&
      request.resource.data.retryCount >= 0 &&
      (!request.resource.data.keys().hasAny(['createdAt']) ||
        request.resource.data.createdAt is timestamp) &&
      (!request.resource.data.keys().hasAny(['updatedAt']) ||
        request.resource.data.updatedAt is timestamp) &&
      (!request.resource.data.keys().hasAny(['claimedAt']) ||
        request.resource.data.claimedAt == null ||
        request.resource.data.claimedAt is timestamp);
    }

    function roomCoreUnchanged() {
      // isPrivate / roomName / createdAt are optional on a room doc (public, unnamed
      // rooms omit them). Use safe .get(...) access so a missing field does not raise
      // an evaluation error (which would wrongly deny a legitimate join/update).
      return request.resource.data.hostId == resource.data.hostId &&
        request.resource.data.mode == resource.data.mode &&
        request.resource.data.maxPlayers == resource.data.maxPlayers &&
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
        request.resource.data.get('isPrivate', false) == resource.data.get('isPrivate', false) &&
        request.resource.data.get('roomName', '') == resource.data.get('roomName', '');
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      match /progressionDevices/{deviceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          progressionCheckpointFieldsAreSafe();
      }

      match /friends/{friendUid} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /match_history/{matchId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /campaignProgress/{stageId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /campaignAttempts/{attemptId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          request.resource.data.uid == uid;
        allow update, delete: if false;
      }

      match /campaignRewardClaims/{claimId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          campaignRewardClaimFieldsAreSafe(uid);
        allow delete: if false;
      }
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      // TODO: Seed campaign definitions through an admin backend or custom claim.
      allow create, update, delete: if false;

      match /stages/{stageId} {
        allow read: if true;
        // TODO: Seed campaign stages through an admin backend or custom claim.
        allow create, update, delete: if false;
      }
    }

    match /public_profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        publicProfileFieldsAreSafe();
      allow delete: if isOwner(uid);
    }

    match /matchmaking_queue/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /invitations/{invitationId} {
      allow read: if signedIn() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow delete: if signedIn() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
    }

    match /matches/{matchId} {
      allow read, create, update: if signedIn();
    }

    match /rooms/{roomId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.players[request.auth.uid] != null;

      allow update: if signedIn() && (
        // 1. Host can make any update (start, kick, score, etc.).
        resource.data.hostId == request.auth.uid ||

        // 2. Existing player can update gameplay fields, but not core room identity.
        (
          resource.data.players[request.auth.uid] != null &&
          roomCoreUnchanged()
        ) ||

        // 3. Any signed-in user may join (lobby or bot-slot replacement) as long
        //    as they are present in the resulting players map and do not change
        //    core room identity (host, mode, maxPlayers).
        (
          request.resource.data.players[request.auth.uid] != null &&
          roomCoreUnchanged()
        )
      );

      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
    }

    match /stageLeaderboards/{leaderboardId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /scores/{uid} {
        allow read: if true;
        // TODO: Move campaign anti-cheat and score verification to Cloud Functions.
        allow create, update: if isOwner(uid) &&
          campaignLeaderboardFieldsAreSafe(uid);
        allow delete: if false;
      }
    }
  }
}
