<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="5dp" />
            <solid android:color="#041342" />
            <stroke
                android:width="1dp"
                android:color="#F5C434" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape>
            <corners android:radius="4dp" />
            <gradient
                android:angle="0"
                android:endColor="#001B69"
                android:startColor="#0738A8" />
        </shape>
    </item>
</layer-list>
