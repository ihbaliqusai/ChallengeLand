<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_confirmation_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/txtConfirmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/baloo"
        android:includeFontPadding="false"
        android:text="تأكيد الاستئجار"
        android:textColor="#FFD54F"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Message Description -->
    <TextView
        android:id="@+id/txtConfirmMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/baloo"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="3dp"
        android:text="استئجار تصنيف «معلومات عامة» لمدة أسبوع (7 أيام) مقابل 4500 قطعة.\nتُضاف المدة إلى الاستئجار الحالي إن كان سارياً."
        android:textColor="#E2E8F0"
        android:textSize="13sp" />

    <!-- Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnConfirmCancel"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_dialog_cancel"
            android:fontFamily="@font/baloo"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:text="إلغاء"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/btnConfirmOk"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_dialog_confirm"
            android:fontFamily="@font/baloo"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:text="تأكيد"
            android:textColor="#451A03"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
