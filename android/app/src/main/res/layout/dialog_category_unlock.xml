<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/dialog_category_unlock_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Artwork + Title + Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Close Button (Top-End) -->
        <TextView
            android:id="@+id/btnCloseDialog"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/dialog_category_close_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Artwork Preview and Titles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btnCloseDialog"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Category Artwork Frame -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/dialog_category_image_frame"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/imgCategoryArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Category Artwork"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCategoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo"
                    android:includeFontPadding="false"
                    android:text="⭐ فئة مميزة وحصرية"
                    android:textColor="#FACC15"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCategoryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/baloo"
                    android:includeFontPadding="false"
                    android:text="فئة مميزة 🌟: ركز شوي"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCategorySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo"
                    android:includeFontPadding="false"
                    android:text="هذه الفئة من الفئات الحصرية! اختر كيف تود فتحها لبدء التحدي:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Glowing Accent Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#3338BDF8" />

    <!-- Body: Dual 3D Action Cards (Ad Rental vs Permanent Gem Unlock) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Card 1: 24h Free Ad Rental -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/dialog_category_card_ad_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/baloo"
                    android:includeFontPadding="false"
                    android:text="استئجار 24 ساعة"
                    android:textColor="#7DD3FC"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/baloo"
                android:includeFontPadding="false"
                android:minLines="2"
                android:text="شاهد إعلاناً قصيراً لتجربة الفئة مجاناً لمدة يوم كامل!"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnRentWithAd"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/dialog_category_btn_ad"
                android:fontFamily="@font/baloo"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text="استئجار مجاني (إعلان 🎥)"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 2: Permanent Gem Unlock -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/dialog_category_card_gem_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/baloo"
                    android:includeFontPadding="false"
                    android:text="امتلاك للأبد"
                    android:textColor="#FCD34D"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtGemsInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/baloo"
                android:includeFontPadding="false"
                android:minLines="2"
                android:text="فتح دائم على حسابك بدون قيود\n(رصيدك: 125 💎)"
                android:textColor="#FEF08A"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnUnlockWithGems"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/dialog_category_btn_gem"
                android:fontFamily="@font/baloo"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text="شراء دائم (150 💎)"
                android:textColor="#451A03"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
