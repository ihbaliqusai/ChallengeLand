<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#08103A" />
            <stroke
                android:width="2dp"
                android:color="#F4E78B" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#001A4D" />
            <stroke
                android:width="1dp"
                android:color="#46E8FF" />
        </shape>
    </item>
</layer-list>
