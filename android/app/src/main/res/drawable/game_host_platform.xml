<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:endColor="#00125A"
                android:startColor="#071AC8" />
            <stroke
                android:width="2dp"
                android:color="#1EE7FF" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:left="8dp"
        android:right="8dp"
        android:top="7dp">
        <shape android:shape="oval">
            <solid android:color="#061044" />
            <stroke
                android:width="1dp"
                android:color="#F5B93A" />
        </shape>
    </item>
</layer-list>
