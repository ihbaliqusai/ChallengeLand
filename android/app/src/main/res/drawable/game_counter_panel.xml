<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:angle="0"
                android:endColor="#FFB62B"
                android:startColor="#FFF1A0" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#07113E" />
            <stroke
                android:width="1dp"
                android:color="#2ED8FF" />
        </shape>
    </item>
</layer-list>
