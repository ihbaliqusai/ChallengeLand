<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#D97706"
                android:centerColor="#B45309"
                android:endColor="#78350F" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FDE68A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FEF08A"
                android:centerColor="#F59E0B"
                android:endColor="#D97706" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FFFBEB" />
        </shape>
    </item>
</selector>
