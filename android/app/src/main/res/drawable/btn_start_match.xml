<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFCF5A"
                android:endColor="#F59E0B" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FFF3A3" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFF1A0"
                android:endColor="#FFB62B" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FFF7C2" />
        </shape>
    </item>
</selector>
