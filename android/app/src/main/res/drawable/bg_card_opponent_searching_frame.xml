<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Card outer ambient shadow -->
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#99000000" />
        </shape>
    </item>

    <!-- Card outer purple glow halo -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="4.5dp"
                android:color="#448B5CF6" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- Card primary neon purple squircle frame -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="3.5dp"
                android:color="#FF8B5CF6" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- Card inner groove and deep dark purple canvas -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:startColor="#FF23143E"
                android:endColor="#FF10081F"
                android:angle="270" />
            <stroke
                android:width="2dp"
                android:color="#FF401970" />
        </shape>
    </item>
</layer-list>
