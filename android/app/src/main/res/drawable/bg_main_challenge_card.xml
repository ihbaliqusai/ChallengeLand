<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glowing gold-cyan championship outer border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="2dp"
                android:color="#99FFD700" />
            <gradient
                android:angle="270"
                android:startColor="#8038BDF8"
                android:centerColor="#501E3A8A"
                android:endColor="#807C3AED" />
        </shape>
    </item>
    <!-- Inner cyan rim & dark surface -->
    <item
        android:left="2.5dp"
        android:top="2.5dp"
        android:right="2.5dp"
        android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="1.2dp"
                android:color="#5538BDF8" />
            <gradient
                android:angle="270"
                android:startColor="#F0091835"
                android:centerColor="#F8071228"
                android:endColor="#FC040A18" />
        </shape>
    </item>
</layer-list>
