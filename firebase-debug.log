[debug] [2026-10-26T05:07:03.352Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/challengeland/rulesets {"name":"projects/challengeland/rulesets/ff79755f-1b88-4504-8735-de5ba3432248","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    // Lifetime history is merged and reserved transactionally by questionHistory.\r\n    match /question_history/{uid}/{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n    match /question_history_sessions/{sessionId} {\r\n      allow read, write: if false;\r\n    }\r\n    match /question_history_rooms/{roomId} {\r\n      allow read, write: if false;\r\n    }\r\n    match /question_history_ready/{roomId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    match /economy_accounts/{uid} {\r\n      allow read: if signedIn() && request.auth.uid == uid;\r\n      allow write: if false;\r\n      match /operations/{operationId} {\r\n        allow read: if signedIn() && request.auth.uid == uid;\r\n        allow write: if false;\r\n      }\r\n    }\r\n\r\n    // Codes, device deduplication and acceptances are server authorities. Only\r\n    // the owner can inspect their referral summary; no client can mint rewards.\r\n    match /referral_accounts/{uid} {\r\n      allow read: if signedIn() && request.auth.uid == uid;\r\n      allow write: if false;\r\n    }\r\n    match /referral_codes/{code} {\r\n      allow read, write: if false;\r\n    }\r\n    match /referral_devices/{deviceHash} {\r\n      allow read, write: if false;\r\n    }\r\n    match /referral_acceptances/{uid} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    function isOwner(uid) {\r\n      return signedIn() && request.auth.uid == uid;\r\n    }\r\n\r\n    // Paid grants and rights have a separate server-only authority. Client\r\n    // snapshots under /users must never be accepted as proof of payment.\r\n    match /commerce_accounts/{uid} {\r\n      allow read: if isOwner(uid);\r\n      allow create, update, delete: if false;\r\n\r\n      match /transactions/{deliveryId} {\r\n        allow read: if isOwner(uid);\r\n        allow create, update, delete: if false;\r\n      }\r\n\r\n      match /entitlements/{entitlementId} {\r\n        allow read: if isOwner(uid);\r\n        allow create, update, delete: if false;\r\n      }\r\n    }\r\n\r\n    // Tokens are credentials used only by the backend verifier and RTDN worker.\r\n    match /commerce_purchase_tokens/{deliveryId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    function nonnegativeInteger(value) {\r\n      return value is int && value >= 0 && value <= 2147483647;\r\n    }\r\n\r\n    function publicProfileFieldsAreSafe() {\r\n      let data = request.resource.data;\r\n      return data.keys().hasOnly([\r\n        'uid',\r\n        'username',\r\n        'photoUrl',\r\n        'friendCode',\r\n        'countryCode',\r\n        'createdAt',\r\n        'lastSeenAt',\r\n        'xp',\r\n        'gamesPlayed',\r\n        'wins',\r\n        'losses',\r\n        'draws',\r\n        'abandoned',\r\n        'correctAnswers',\r\n        'wrongAnswers',\r\n        'totalEarnings',\r\n        'onlineWins',\r\n        'trophiesEarned',\r\n        'trophiesLost',\r\n        'blitzFinishes',\r\n        'eliminationWins',\r\n        'survivalWins',\r\n        'seriesWins',\r\n        'teamBattleWins',\r\n        'localTeamsPlayed',\r\n        'offlineBoardPlayed',\r\n        'offlineBoardWins',\r\n        'friendMatchesPlayed',\r\n        'randomMatchesPlayed',\r\n        'bestStreak',\r\n        'bestWinStreak',\r\n        'highestMoney',\r\n        'bestTrophies',\r\n        'trophies',\r\n        'winStreak',\r\n        'lastPrize',\r\n        'level',\r\n        'totalAnswered',\r\n        'accuracy',\r\n        'winPercent',\r\n        'progressionVersion',\r\n        'totalMatches',\r\n        'totalScore',\r\n        'rating'\r\n      ]) &&\r\n        data.uid is string &&\r\n        data.get('username', '') is string &&\r\n        (data.get('photoUrl', null) == null || data.photoUrl is string) &&\r\n        data.get('friendCode', '') is string &&\r\n        (!('countryCode' in data) ||\r\n          (data.countryCode is string && data.countryCode.matches('^[A-Z]{2}$'))) &&\r\n        (data.get('createdAt', null) == null || data.createdAt is timestamp) &&\r\n        (data.get('lastSeenAt', null) == null || data.lastSeenAt is timestamp) &&\r\n        nonnegativeInteger(data.get('xp', 0)) &&\r\n        nonnegativeInteger(data.get('gamesPlayed', 0)) &&\r\n        nonnegativeInteger(data.get('wins', 0)) &&\r\n        nonnegativeInteger(data.get('losses', 0)) &&\r\n        nonnegativeInteger(data.get('draws', 0)) &&\r\n        nonnegativeInteger(data.get('abandoned', 0)) &&\r\n        nonnegativeInteger(data.get('correctAnswers', 0)) &&\r\n        nonnegativeInteger(data.get('wrongAnswers', 0)) &&\r\n        nonnegativeInteger(data.get('totalEarnings', 0)) &&\r\n        nonnegativeInteger(data.get('onlineWins', 0)) &&\r\n        nonnegativeInteger(data.get('trophiesEarned', 0)) &&\r\n        nonnegativeInteger(data.get('trophiesLost', 0)) &&\r\n        nonnegativeInteger(data.get('blitzFinishes', 0)) &&\r\n        nonnegativeInteger(data.get('eliminationWins', 0)) &&\r\n        nonnegativeInteger(data.get('survivalWins', 0)) &&\r\n        nonnegativeInteger(data.get('seriesWins', 0)) &&\r\n        nonnegativeInteger(data.get('teamBattleWins', 0)) &&\r\n        nonnegativeInteger(data.get('localTeamsPlayed', 0)) &&\r\n        nonnegativeInteger(data.get('offlineBoardPlayed', 0)) &&\r\n        nonnegativeInteger(data.get('offlineBoardWins', 0)) &&\r\n        nonnegativeInteger(data.get('friendMatchesPlayed', 0)) &&\r\n        nonnegativeInteger(data.get('randomMatchesPlayed', 0)) &&\r\n        nonnegativeInteger(data.get('bestStreak', 0)) &&\r\n        nonnegativeInteger(data.get('bestWinStreak', 0)) &&\r\n        nonnegativeInteger(data.get('highestMoney', 0)) &&\r\n        nonnegativeInteger(data.get('bestTrophies', 0)) &&\r\n        nonnegativeInteger(data.get('trophies', 0)) &&\r\n        nonnegativeInteger(data.get('winStreak', 0)) &&\r\n        nonnegativeInteger(data.get('lastPrize', 0)) &&\r\n        nonnegativeInteger(data.get('level', 0)) &&\r\n        nonnegativeInteger(data.get('totalAnswered', 0)) &&\r\n        nonnegativeInteger(data.get('accuracy', 0)) &&\r\n        nonnegativeInteger(data.get('winPercent', 0)) &&\r\n        nonnegativeInteger(data.get('progressionVersion', 0)) &&\r\n        nonnegativeInteger(data.get('totalMatches', 0)) &&\r\n        nonnegativeInteger(data.get('totalScore', 0)) &&\r\n        nonnegativeInteger(data.get('rating', 0)) &&\r\n        data.get('level', 1) >= 1 &&\r\n        data.get('accuracy', 0) <= 100 &&\r\n        data.get('winPercent', 0) <= 100;\r\n    }\r\n\r\n    // Integer arithmetic retains its type; a float in any group makes its sum\r\n    // a float. Checking the sum once plus each sign keeps all 72 counters\r\n    // validated within Firestore's 1000-expression budget. Contributions are\r\n    // cumulative int64 checkpoints; displayed account totals use int32 bounds.\r\n    function validContributionGroup0(counters) {\r\n      let value0 = counters.get('xp', 0);\r\n      let value1 = counters.get('gamesPlayed', 0);\r\n      let value2 = counters.get('wins', 0);\r\n      let value3 = counters.get('losses', 0);\r\n      let value4 = counters.get('draws', 0);\r\n      let value5 = counters.get('abandoned', 0);\r\n      let value6 = counters.get('correctAnswers', 0);\r\n      let value7 = counters.get('wrongAnswers', 0);\r\n      let value8 = counters.get('totalEarnings', 0);\r\n      let value9 = counters.get('onlineWins', 0);\r\n      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&\r\n        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;\r\n    }\r\n\r\n    function validContributionGroup1(counters) {\r\n      let value0 = counters.get('trophiesEarned', 0);\r\n      let value1 = counters.get('trophiesLost', 0);\r\n      let value2 = counters.get('blitzFinishes', 0);\r\n      let value3 = counters.get('eliminationWins', 0);\r\n      let value4 = counters.get('survivalWins', 0);\r\n      let value5 = counters.get('seriesWins', 0);\r\n      let value6 = counters.get('teamBattleWins', 0);\r\n      let value7 = counters.get('localTeamsPlayed', 0);\r\n      let value8 = counters.get('offlineBoardPlayed', 0);\r\n      let value9 = counters.get('offlineBoardWins', 0);\r\n      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&\r\n        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;\r\n    }\r\n\r\n    function validContributionGroup2(counters) {\r\n      let value0 = counters.get('friendMatchesPlayed', 0);\r\n      let value1 = counters.get('randomMatchesPlayed', 0);\r\n      let value2 = counters.get('mode_campaign_games', 0);\r\n      let value3 = counters.get('mode_campaign_wins', 0);\r\n      let value4 = counters.get('mode_campaign_losses', 0);\r\n      let value5 = counters.get('mode_campaign_draws', 0);\r\n      let value6 = counters.get('mode_campaign_abandoned', 0);\r\n      let value7 = counters.get('mode_offline_games', 0);\r\n      let value8 = counters.get('mode_offline_wins', 0);\r\n      let value9 = counters.get('mode_offline_losses', 0);\r\n      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&\r\n        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;\r\n    }\r\n\r\n    function validContributionGroup3(counters) {\r\n      let value0 = counters.get('mode_offline_draws', 0);\r\n      let value1 = counters.get('mode_offline_abandoned', 0);\r\n      let value2 = counters.get('mode_local_teams_games', 0);\r\n      let value3 = counters.get('mode_local_teams_wins', 0);\r\n      let value4 = counters.get('mode_local_teams_losses', 0);\r\n      let value5 = counters.get('mode_local_teams_draws', 0);\r\n      let value6 = counters.get('mode_local_teams_abandoned', 0);\r\n      let value7 = counters.get('mode_board_games', 0);\r\n      let value8 = counters.get('mode_board_wins', 0);\r\n      let value9 = counters.get('mode_board_losses', 0);\r\n      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&\r\n        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;\r\n    }\r\n\r\n    function validContributionGroup4(counters) {\r\n      let value0 = counters.get('mode_board_draws', 0);\r\n      let value1 = counters.get('mode_board_abandoned', 0);\r\n      let value2 = counters.get('mode_battle_games', 0);\r\n      let value3 = counters.get('mode_battle_wins', 0);\r\n      let value4 = counters.get('mode_battle_losses', 0);\r\n      let value5 = counters.get('mode_battle_draws', 0);\r\n      let value6 = counters.get('mode_battle_abandoned', 0);\r\n      let value7 = counters.get('mode_team_battle_games', 0);\r\n      let value8 = counters.get('mode_team_battle_wins', 0);\r\n      let value9 = counters.get('mode_team_battle_losses', 0);\r\n      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&\r\n        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;\r\n    }\r\n\r\n    function validContributionGroup5(counters) {\r\n      let value0 = counters.get('mode_team_battle_draws', 0);\r\n      let value1 = counters.get('mode_team_battle_abandoned', 0);\r\n      let value2 = counters.get('mode_blitz_games', 0);\r\n      let value3 = counters.get('mode_blitz_wins', 0);\r\n      let value4 = counters.get('mode_blitz_losses', 0);\r\n      let value5 = counters.get('mode_blitz_draws', 0);\r\n      let value6 = counters.get('mode_blitz_abandoned', 0);\r\n      let value7 = counters.get('mode_elimination_games', 0);\r\n      let value8 = counters.get('mode_elimination_wins', 0);\r\n      let value9 = counters.get('mode_elimination_losses', 0);\r\n      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&\r\n        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;\r\n    }\r\n\r\n    function validContributionGroup6(counters) {\r\n      let value0 = counters.get('mode_elimination_draws', 0);\r\n      let value1 = counters.get('mode_elimination_abandoned', 0);\r\n      let value2 = counters.get('mode_survival_games', 0);\r\n      let value3 = counters.get('mode_survival_wins', 0);\r\n      let value4 = counters.get('mode_survival_losses', 0);\r\n      let value5 = counters.get('mode_survival_draws', 0);\r\n      let value6 = counters.get('mode_survival_abandoned', 0);\r\n      let value7 = counters.get('mode_series_games', 0);\r\n      let value8 = counters.get('mode_series_wins', 0);\r\n      let value9 = counters.get('mode_series_losses', 0);\r\n      return (value0 + value1 + value2 + value3 + value4 + value5 + value6 + value7 + value8 + value9) is int &&\r\n        value0 >= 0 && value1 >= 0 && value2 >= 0 && value3 >= 0 && value4 >= 0 && value5 >= 0 && value6 >= 0 && value7 >= 0 && value8 >= 0 && value9 >= 0;\r\n    }\r\n\r\n    function validContributionGroup7(counters) {\r\n      let value0 = counters.get('mode_series_draws', 0);\r\n      let value1 = counters.get('mode_series_abandoned', 0);\r\n      return (value0 + value1) is int &&\r\n        value0 >= 0 && value1 >= 0;\r\n    }\r\n\r\n    function progressionCheckpointFieldsAreSafe() {\r\n      let data = request.resource.data;\r\n      let counters = data.contributions;\r\n      return data.keys().hasOnly(['contributions', 'updatedAt', 'version']) &&\r\n        data.version == 2 && data.updatedAt is timestamp &&\r\n        counters is map &&\r\n        // Only canonical counters are copied by ProgressionService. Unknown\r\n        // private keys never enter the separately whitelisted public profile.\r\n        counters.keys().size() <= 73 &&\r\n        validContributionGroup0(counters) &&\r\n        validContributionGroup1(counters) &&\r\n        validContributionGroup2(counters) &&\r\n        validContributionGroup3(counters) &&\r\n        validContributionGroup4(counters) &&\r\n        validContributionGroup5(counters) &&\r\n        validContributionGroup6(counters) &&\r\n        validContributionGroup7(counters) &&\r\n        counters.get('trophies', 0) is int &&\r\n        counters.get('trophies', 0) >= -2147483647 &&\r\n        counters.get('trophies', 0) <= 2147483647;\r\n    }\r\n\r\n    function campaignLeaderboardFieldsAreSafe(uid) {\r\n      return request.resource.data.keys().hasOnly([\r\n        'uid',\r\n        'displayName',\r\n        'photoUrl',\r\n        'campaignId',\r\n        'stageId',\r\n        'score',\r\n        'stars',\r\n        'money',\r\n        'correctAnswers',\r\n        'timeMs',\r\n        'usedLifelines',\r\n        'assisted',\r\n        'updatedAt'\r\n      ]) &&\r\n      request.resource.data.uid == uid &&\r\n      request.resource.data.uid is string &&\r\n      request.resource.data.displayName is string &&\r\n      request.resource.data.campaignId is string &&\r\n      request.resource.data.stageId is string &&\r\n      request.resource.data.score is int &&\r\n      request.resource.data.score >= 0 &&\r\n      request.resource.data.stars is int &&\r\n      request.resource.data.stars >= 0 &&\r\n      request.resource.data.stars <= 3 &&\r\n      request.resource.data.money is int &&\r\n      request.resource.data.money >= 0 &&\r\n      request.resource.data.correctAnswers is int &&\r\n      request.resource.data.correctAnswers >= 0 &&\r\n      request.resource.data.timeMs is int &&\r\n      request.resource.data.timeMs >= 0 &&\r\n      request.resource.data.usedLifelines is int &&\r\n      request.resource.data.usedLifelines >= 0 &&\r\n      request.resource.data.assisted is bool &&\r\n      (!request.resource.data.keys().hasAny(['photoUrl']) ||\r\n        request.resource.data.photoUrl == null ||\r\n        request.resource.data.photoUrl is string) &&\r\n      (!request.resource.data.keys().hasAny(['updatedAt']) ||\r\n        request.resource.data.updatedAt is timestamp);\r\n    }\r\n\r\n    function campaignRewardClaimFieldsAreSafe(uid) {\r\n      return request.resource.data.keys().hasOnly([\r\n        'uid',\r\n        'campaignId',\r\n        'stageId',\r\n        'previousStars',\r\n        'newStars',\r\n        'coins',\r\n        'gems',\r\n        'xp',\r\n        'status',\r\n        'createdAt',\r\n        'claimedAt',\r\n        'updatedAt',\r\n        'attemptId',\r\n        'currencyClaimed',\r\n        'xpClaimed',\r\n        'retryCount'\r\n      ]) &&\r\n      request.resource.data.uid == uid &&\r\n      request.resource.data.uid is string &&\r\n      request.resource.data.campaignId is string &&\r\n      request.resource.data.stageId is string &&\r\n      request.resource.data.previousStars is int &&\r\n      request.resource.data.previousStars >= 0 &&\r\n      request.resource.data.previousStars <= 3 &&\r\n      request.resource.data.newStars is int &&\r\n      request.resource.data.newStars >= 0 &&\r\n      request.resource.data.newStars <= 3 &&\r\n      request.resource.data.coins is int &&\r\n      request.resource.data.coins >= 0 &&\r\n      request.resource.data.gems is int &&\r\n      request.resource.data.gems >= 0 &&\r\n      request.resource.data.xp is int &&\r\n      request.resource.data.xp >= 0 &&\r\n      request.resource.data.status in ['pending', 'claimed', 'failed'] &&\r\n      request.resource.data.attemptId is string &&\r\n      request.resource.data.currencyClaimed is bool &&\r\n      request.resource.data.xpClaimed is bool &&\r\n      request.resource.data.retryCount is int &&\r\n      request.resource.data.retryCount >= 0 &&\r\n      (!request.resource.data.keys().hasAny(['createdAt']) ||\r\n        request.resource.data.createdAt is timestamp) &&\r\n      (!request.resource.data.keys().hasAny(['updatedAt']) ||\r\n        request.resource.data.updatedAt is timestamp) &&\r\n      (!request.resource.data.keys().hasAny(['claimedAt']) ||\r\n        request.resource.data.claimedAt == null ||\r\n        request.resource.data.claimedAt is timestamp);\r\n    }\r\n\r\n    function roomCoreUnchanged() {\r\n      // isPrivate / roomName / createdAt are optional on a room doc (public, unnamed\r\n      // rooms omit them). Use safe .get(...) access so a missing field does not raise\r\n      // an evaluation error (which would wrongly deny a legitimate join/update).\r\n      return request.resource.data.hostId == resource.data.hostId &&\r\n        request.resource.data.mode == resource.data.mode &&\r\n        request.resource.data.maxPlayers == resource.data.maxPlayers &&\r\n        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&\r\n        request.resource.data.get('isPrivate', false) == resource.data.get('isPrivate', false) &&\r\n        request.resource.data.get('roomName', '') == resource.data.get('roomName', '');\r\n    }\r\n\r\n    match /users/{uid} {\r\n      allow read: if isOwner(uid);\r\n      // The existing game economy retains its own reward paths. A held friend\r\n      // stake cannot be overwritten by a stale client wallet snapshot, and its\r\n      // revision/lock markers are exclusively owned by the settlement server.\r\n      allow create: if isOwner(uid) &&\r\n        request.resource.data.get('referralRevision', 0) == 0 &&\r\n        request.resource.data.get('friendStakeRevision', 0) == 0 &&\r\n        request.resource.data.get('friendStakeMatchId', '') == '';\r\n      allow update: if isOwner(uid) &&\r\n        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['friendStakeRevision', 'friendStakeMatchId', 'referralRevision']) &&\r\n        (resource.data.get('friendStakeMatchId', '') == '' ||\r\n          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins']));\r\n      allow delete: if isOwner(uid) && resource.data.get('friendStakeMatchId', '') == '';\r\n\r\n      match /progressionDevices/{deviceId} {\r\n        allow read, delete: if isOwner(uid);\r\n        allow create, update: if isOwner(uid) &&\r\n          progressionCheckpointFieldsAreSafe();\r\n      }\r\n\r\n      match /friends/{friendUid} {\r\n        allow read, create, update, delete: if isOwner(uid);\r\n      }\r\n\r\n      match /match_history/{matchId} {\r\n        allow read, create, update, delete: if isOwner(uid);\r\n      }\r\n\r\n      match /campaignProgress/{stageId} {\r\n        allow read, create, update: if isOwner(uid);\r\n        allow delete: if false;\r\n      }\r\n\r\n      match /campaignAttempts/{attemptId} {\r\n        allow read: if isOwner(uid);\r\n        allow create: if isOwner(uid) &&\r\n          request.resource.data.uid == uid;\r\n        allow update, delete: if false;\r\n      }\r\n\r\n      match /campaignRewardClaims/{claimId} {\r\n        allow read: if isOwner(uid);\r\n        allow create, update: if isOwner(uid) &&\r\n          campaignRewardClaimFieldsAreSafe(uid);\r\n        allow delete: if false;\r\n      }\r\n    }\r\n\r\n    match /campaigns/{campaignId} {\r\n      allow read: if true;\r\n      // TODO: Seed campaign definitions through an admin backend or custom claim.\r\n      allow create, update, delete: if false;\r\n\r\n      match /stages/{stageId} {\r\n        allow read: if true;\r\n        // TODO: Seed campaign stages through an admin backend or custom claim.\r\n        allow create, update, delete: if false;\r\n      }\r\n    }\r\n\r\n    // Social v1: mutual consent, server deadlines, rate limits and a two-player\r\n    // reservation committed in the same transaction as challenge acceptance.\r\n    function socialPair(id, a, b) {\r\n      return a is string && b is string && a.matches('^[A-Za-z0-9_-]{1,128}$') &&\r\n        b.matches('^[A-Za-z0-9_-]{1,128}$') && a != b &&\r\n        id == (a < b ? a + ':' + b : b + ':' + a);\r\n    }\r\n    function socialMember(data) {\r\n      return socialSignedIn() && request.auth.uid in data.members;\r\n    }\r\n    function socialSignedIn() {\r\n      return signedIn() && (!('firebase' in request.auth.token) ||\r\n        request.auth.token.firebase.sign_in_provider != 'anonymous');\r\n    }\r\n    function socialOwner(uid) {\r\n      return socialSignedIn() && request.auth.uid == uid;\r\n    }\r\n    function socialUnblocked(a, b) {\r\n      return !exists(/databases/$(database)/documents/social_blocks/$(a + ':' + b)) &&\r\n        !exists(/databases/$(database)/documents/social_blocks/$(b + ':' + a));\r\n    }\r\n    function socialFriends(a, b) {\r\n      let id = a < b ? a + ':' + b : b + ':' + a;\r\n      return exists(/databases/$(database)/documents/social_links/$(id)) &&\r\n        get(/databases/$(database)/documents/social_links/$(id)).data.status == 'accepted';\r\n    }\r\n    function socialAvailable(uid) {\r\n      let p = get(/databases/$(database)/documents/player_presence/$(uid)).data;\r\n      return p.state == 'available' && p.heartbeatAt > request.time - duration.value(75, 's');\r\n    }\r\n    function socialFree(uid) {\r\n      return !exists(/databases/$(database)/documents/social_reservations/$(uid)) ||\r\n        get(/databases/$(database)/documents/social_reservations/$(uid)).data.expiresAt <= request.time;\r\n    }\r\n    function socialPolicy(a, b) {\r\n      return !exists(/databases/$(database)/documents/social_settings/$(b)) ||\r\n        get(/databases/$(database)/documents/social_settings/$(b)).data.allowChallenges == 'everyone' ||\r\n        (get(/databases/$(database)/documents/social_settings/$(b)).data.allowChallenges == 'friends' && socialFriends(a, b));\r\n    }\r\n    function socialRate(field) {\r\n      let path = /databases/$(database)/documents/social_limits/$(request.auth.uid);\r\n      return getAfter(path).data[field] == request.time &&\r\n        (!exists(path) || !(field in get(path).data) ||\r\n          get(path).data[field] <= request.time - duration.value(10, 's'));\r\n    }\r\n    function socialEnvelope(id, challenge) {\r\n      let d = request.resource.data;\r\n      return socialSignedIn() && socialPair(id, d.fromUid, d.toUid) &&\r\n        d.members is list && d.members.size() == 2 && d.fromUid in d.members && d.toUid in d.members &&\r\n        d.fromUid == request.auth.uid && d.status == 'pending' &&\r\n        d.createdAt == request.time && d.updatedAt == request.time && d.expiresAt is timestamp &&\r\n        d.keys().hasAll(['members', 'fromUid', 'toUid', 'status', 'createdAt', 'updatedAt', 'expiresAt']) &&\r\n        d.keys().hasOnly(challenge ? ['members', 'fromUid', 'toUid', 'status', 'createdAt', 'updatedAt', 'expiresAt', 'mode'] :\r\n          ['members', 'fromUid', 'toUid', 'status', 'createdAt', 'updatedAt', 'expiresAt']) &&\r\n        socialUnblocked(d.fromUid, d.toUid) &&\r\n        (challenge ? (d.mode == 'duel' && d.expiresAt > request.time + duration.value(20, 's') &&\r\n            d.expiresAt <= request.time + duration.value(40, 's') &&\r\n            socialAvailable(d.fromUid) && socialAvailable(d.toUid) &&\r\n            socialFree(d.toUid) && socialPolicy(d.fromUid, d.toUid) &&\r\n            socialRate('challengeSentAt')) :\r\n          (d.expiresAt > request.time + duration.value(6, 'd') &&\r\n            d.expiresAt <= request.time + duration.value(7, 'd') + duration.value(10, 's') && socialRate('friendSentAt')));\r\n    }\r\n    function socialTransition(challenge) {\r\n      let old = resource.data;\r\n      let d = request.resource.data;\r\n      return socialMember(old) && d.updatedAt == request.time &&\r\n        d.diff(old).affectedKeys().hasOnly(challenge ? ['status', 'updatedAt', 'acceptedAt'] : ['status', 'updatedAt']) &&\r\n        ((old.status == 'pending' && old.expiresAt > request.time &&\r\n          ((d.status == 'cancelled' && old.fromUid == request.auth.uid) ||\r\n           (d.status == 'declined' && old.toUid == request.auth.uid) ||\r\n           (d.status == 'accepted' && old.toUid == request.auth.uid && socialUnblocked(old.fromUid, old.toUid) &&\r\n             (!challenge || socialAcceptance(old, d))))) ||\r\n          (!challenge && old.status == 'accepted' && d.status == 'removed'));\r\n    }\r\n    function socialAcceptance(old, d) {\r\n      let a = getAfter(/databases/$(database)/documents/social_reservations/$(old.fromUid)).data;\r\n      let b = getAfter(/databases/$(database)/documents/social_reservations/$(old.toUid)).data;\r\n      return d.acceptedAt == request.time && a.acceptedAt == request.time && b.acceptedAt == request.time &&\r\n        socialPair(a.challengeId, old.fromUid, old.toUid) && a.challengeId == b.challengeId &&\r\n        socialAvailable(old.fromUid) && socialAvailable(old.toUid) && socialPolicy(old.fromUid, old.toUid);\r\n    }\r\n    match /player_presence/{uid} {\r\n      allow get: if socialSignedIn() && (!exists(/databases/$(database)/documents/player_presence/$(uid)) ||\r\n        socialOwner(uid) || resource.data.discoverable == true ||\r\n          (socialFriends(uid, request.auth.uid) && socialUnblocked(uid, request.auth.uid)));\r\n      allow list: if socialSignedIn() && resource.data.discoverable == true;\r\n      allow create, update: if socialOwner(uid) && request.resource.data.keys().hasOnly(['uid', 'heartbeatAt', 'state', 'discoverable']) &&\r\n        request.resource.data.uid == uid && request.resource.data.heartbeatAt == request.time &&\r\n        request.resource.data.state in ['available', 'in_match', 'away'] && request.resource.data.discoverable is bool &&\r\n        (!exists(/databases/$(database)/documents/social_settings/$(uid)) ? request.resource.data.discoverable == true :\r\n          request.resource.data.discoverable == get(/databases/$(database)/documents/social_settings/$(uid)).data.discoverable);\r\n      allow delete: if socialOwner(uid);\r\n    }\r\n    match /social_settings/{uid} {\r\n      allow read: if socialSignedIn();\r\n      allow create, update: if socialOwner(uid) && request.resource.data.keys().hasOnly(['discoverable', 'allowChallenges']) &&\r\n        request.resource.data.discoverable is bool && request.resource.data.allowChallenges in ['everyone', 'friends', 'none'];\r\n      allow delete: if socialOwner(uid);\r\n    }\r\n    match /social_blocks/{id} {\r\n      allow get: if socialSignedIn() &&\r\n        (id.matches('^' + request.auth.uid + ':[A-Za-z0-9_-]{1,128}$') ||\r\n          id.matches('^[A-Za-z0-9_-]{1,128}:' + request.auth.uid + '$'));\r\n      allow list: if socialSignedIn() && resource.data.ownerUid == request.auth.uid;\r\n      allow create: if socialSignedIn() && request.resource.data.ownerUid == request.auth.uid &&\r\n        request.resource.data.targetUid is string && request.resource.data.targetUid != request.auth.uid &&\r\n        id == request.auth.uid + ':' + request.resource.data.targetUid &&\r\n        request.resource.data.keys().hasOnly(['ownerUid', 'targetUid', 'createdAt']) && request.resource.data.createdAt == request.time;\r\n      allow update: if false;\r\n      allow delete: if socialSignedIn() && resource.data.ownerUid == request.auth.uid;\r\n    }\r\n    match /social_limits/{uid} {\r\n      allow read: if socialOwner(uid);\r\n      allow delete: if socialOwner(uid) && !existsAfter(/databases/$(database)/documents/users/$(uid));\r\n      allow create, update: if socialOwner(uid) && request.resource.data.keys().hasOnly(['friendSentAt', 'challengeSentAt']) &&\r\n        request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['friendSentAt', 'challengeSentAt']) &&\r\n        (!('friendSentAt' in request.resource.data) || request.resource.data.friendSentAt == request.time ||\r\n          (resource != null && request.resource.data.friendSentAt == resource.data.friendSentAt)) &&\r\n        (!('challengeSentAt' in request.resource.data) || request.resource.data.challengeSentAt == request.time ||\r\n          (resource != null && request.resource.data.challengeSentAt == resource.data.challengeSentAt)) &&\r\n        (resource == null || request.resource.data.keys().hasAll(resource.data.keys()));\r\n    }\r\n    match /social_links/{id} {\r\n      allow get: if socialSignedIn() && (!exists(/databases/$(database)/documents/social_links/$(id)) || socialMember(resource.data));\r\n      allow list, delete: if socialMember(resource.data);\r\n      allow create: if socialEnvelope(id, false);\r\n      allow update: if socialTransition(false) || (resource.data.status != 'accepted' &&\r\n        (resource.data.status != 'pending' || resource.data.expiresAt <= request.time) &&\r\n        resource.data.updatedAt <= request.time - duration.value(30, 's') && socialEnvelope(id, false));\r\n    }\r\n    match /social_challenges/{id} {\r\n      allow get: if socialSignedIn() && (!exists(/databases/$(database)/documents/social_challenges/$(id)) || socialMember(resource.data));\r\n      allow list: if socialMember(resource.data);\r\n      allow delete: if socialMember(resource.data) && resource.data.get('serverStake', false) == false;\r\n      allow create: if socialEnvelope(id, true);\r\n      allow update: if (resource.data.get('serverStake', false) == false && socialTransition(true)) ||\r\n        (socialChallengeEnded(resource.data) &&\r\n          (resource.data.status != 'pending' || resource.data.expiresAt <= request.time) &&\r\n          resource.data.updatedAt <= request.time - duration.value(30, 's') && socialEnvelope(id, true));\r\n    }\r\n    function socialChallengeEnded(d) {\r\n      let matchPath = /databases/$(database)/documents/friend_stake_views/$(d.get('stakeMatchId', '_'));\r\n      return d.get('serverStake', false) == false ||\r\n        (d.status != 'accepted' && (d.status != 'pending' || d.expiresAt <= request.time)) ||\r\n        (d.status == 'accepted' && exists(matchPath) && get(matchPath).data.status == 'settled');\r\n    }\r\n    match /social_reservations/{uid} {\r\n      allow get: if socialSignedIn();\r\n      allow delete: if socialOwner(uid) &&\r\n        resource.data.get('serverStake', false) == false &&\r\n        (!exists(/databases/$(database)/documents/social_reservations/$(uid)) ||\r\n          resource.data.expiresAt <= request.time ||\r\n          !existsAfter(/databases/$(database)/documents/users/$(uid)) ||\r\n          (get(/databases/$(database)/documents/player_presence/$(uid)).data.state in ['in_match', 'away'] &&\r\n            getAfter(/databases/$(database)/documents/player_presence/$(uid)).data.state == 'available'));\r\n      allow create, update: if socialSignedIn() && socialFree(uid) &&\r\n        (!exists(/databases/$(database)/documents/social_reservations/$(uid)) || resource.data.get('serverStake', false) == false || resource.data.get('settled', false) == true) &&\r\n        request.resource.data.keys().hasOnly(['challengeId', 'acceptedAt', 'expiresAt']) &&\r\n        request.resource.data.acceptedAt == request.time && request.resource.data.expiresAt is timestamp &&\r\n        request.resource.data.expiresAt > request.time + duration.value(110, 's') &&\r\n        request.resource.data.expiresAt <= request.time + duration.value(130, 's') &&\r\n        socialReservationFor(uid, request.resource.data.challengeId);\r\n    }\r\n    function socialReservationFor(uid, id) {\r\n      let d = getAfter(/databases/$(database)/documents/social_challenges/$(id)).data;\r\n      return d.get('serverStake', false) == false && d.status == 'accepted' && d.acceptedAt == request.time &&\r\n        request.auth.uid == d.toUid && uid in d.members;\r\n    }\r\n\r\n    // Paid friend games have a separate server authority. No RTDB board,\r\n    // client score, invitation mutation or report can settle a pot.\r\n    match /friend_stake_matches/{matchId} {\r\n      allow read, write: if false;\r\n    }\r\n    match /friend_stake_escrows/{matchId} {\r\n      allow read, write: if false;\r\n    }\r\n    match /friend_stake_views/{matchId} {\r\n      allow read: if socialSignedIn() && request.auth.uid in resource.data.members;\r\n      allow write: if false;\r\n    }\r\n    match /friend_stake_locks/{uid} {\r\n      allow read: if socialOwner(uid);\r\n      allow write: if false;\r\n    }\r\n    match /friend_stake_operations/{uid}/items/{operationId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    match /public_profiles/{uid} {\r\n      allow read: if signedIn();\r\n      allow create, update: if isOwner(uid) &&\r\n        request.resource.data.uid == uid &&\r\n        publicProfileFieldsAreSafe();\r\n      allow delete: if isOwner(uid);\r\n    }\r\n\r\n    match /matchmaking_queue/{uid} {\r\n      allow read, create, update, delete: if isOwner(uid);\r\n    }\r\n\r\n    match /invitations/{invitationId} {\r\n      allow read: if signedIn() && (\r\n        resource.data.toUid == request.auth.uid ||\r\n        resource.data.fromUid == request.auth.uid\r\n      );\r\n      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;\r\n      allow update: if signedIn() && (\r\n        resource.data.toUid == request.auth.uid ||\r\n        resource.data.fromUid == request.auth.uid\r\n      );\r\n      allow delete: if signedIn() && (\r\n        resource.data.toUid == request.auth.uid ||\r\n        resource.data.fromUid == request.auth.uid\r\n      );\r\n    }\r\n\r\n    match /matches/{matchId} {\r\n      allow read, create, update: if signedIn();\r\n    }\r\n\r\n    match /rooms/{roomId} {\r\n      allow read: if signedIn();\r\n\r\n      allow create: if signedIn() &&\r\n        request.resource.data.hostId == request.auth.uid &&\r\n        request.resource.data.players[request.auth.uid] != null;\r\n\r\n      allow update: if signedIn() && (\r\n        // 1. Host can make any update (start, kick, score, etc.).\r\n        resource.data.hostId == request.auth.uid ||\r\n\r\n        // 2. Existing player can update gameplay fields, but not core room identity.\r\n        (\r\n          resource.data.players[request.auth.uid] != null &&\r\n          roomCoreUnchanged()\r\n        ) ||\r\n\r\n        // 3. Any signed-in user may join (lobby or bot-slot replacement) as long\r\n        //    as they are present in the resulting players map and do not change\r\n        //    core room identity (host, mode, maxPlayers).\r\n        (\r\n          request.resource.data.players[request.auth.uid] != null &&\r\n          roomCoreUnchanged()\r\n        )\r\n      );\r\n\r\n      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;\r\n    }\r\n\r\n    match /stageLeaderboards/{leaderboardId} {\r\n      allow read: if true;\r\n      allow create, update, delete: if false;\r\n\r\n      match /scores/{uid} {\r\n        allow read: if true;\r\n        // TODO: Move campaign anti-cheat and score verification to Cloud Functions.\r\n        allow create, update: if isOwner(uid) &&\r\n          campaignLeaderboardFieldsAreSafe(uid);\r\n        allow delete: if false;\r\n      }\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-26T05:07:03.251471Z","metadata":{"services":["cloud.firestore"]}}
