[debug] [2026-10-03T09:18:14.149Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/challengeland/rulesets {"name":"projects/challengeland/rulesets/dae48117-5694-4a18-910a-a4b120435652","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isOwner(uid) {\n      return signedIn() && request.auth.uid == uid;\n    }\n\n    // Paid grants and rights have a separate server-only authority. Client\n    // snapshots under /users must never be accepted as proof of payment.\n    match /commerce_accounts/{uid} {\n      allow read: if isOwner(uid);\n      allow create, update, delete: if false;\n\n      match /transactions/{deliveryId} {\n        allow read: if isOwner(uid);\n        allow create, update, delete: if false;\n      }\n\n      match /entitlements/{entitlementId} {\n        allow read: if isOwner(uid);\n        allow create, update, delete: if false;\n      }\n    }\n\n    // Tokens are credentials used only by the backend verifier and RTDN worker.\n    match /commerce_purchase_tokens/{deliveryId} {\n      allow read, write: if false;\n    }\n\r\n    function publicProfileFieldsAreSafe() {\r\n      return request.resource.data.keys().hasOnly([\r\n        'uid',\r\n        'username',\r\n        'photoUrl',\r\n        'rating',\r\n        'trophies',\r\n        'level',\r\n        'createdAt',\r\n        'lastSeenAt'\r\n      ]);\r\n    }\r\n\r\n    function campaignLeaderboardFieldsAreSafe(uid) {\r\n      return request.resource.data.keys().hasOnly([\r\n        'uid',\r\n        'displayName',\r\n        'photoUrl',\r\n        'campaignId',\r\n        'stageId',\r\n        'score',\r\n        'stars',\r\n        'money',\r\n        'correctAnswers',\r\n        'timeMs',\r\n        'usedLifelines',\r\n        'assisted',\r\n        'updatedAt'\r\n      ]) &&\r\n      request.resource.data.uid == uid &&\r\n      request.resource.data.uid is string &&\r\n      request.resource.data.displayName is string &&\r\n      request.resource.data.campaignId is string &&\r\n      request.resource.data.stageId is string &&\r\n      request.resource.data.score is int &&\r\n      request.resource.data.score >= 0 &&\r\n      request.resource.data.stars is int &&\r\n      request.resource.data.stars >= 0 &&\r\n      request.resource.data.stars <= 3 &&\r\n      request.resource.data.money is int &&\r\n      request.resource.data.money >= 0 &&\r\n      request.resource.data.correctAnswers is int &&\r\n      request.resource.data.correctAnswers >= 0 &&\r\n      request.resource.data.timeMs is int &&\r\n      request.resource.data.timeMs >= 0 &&\r\n      request.resource.data.usedLifelines is int &&\r\n      request.resource.data.usedLifelines >= 0 &&\r\n      request.resource.data.assisted is bool &&\r\n      (!request.resource.data.keys().hasAny(['photoUrl']) ||\r\n        request.resource.data.photoUrl == null ||\r\n        request.resource.data.photoUrl is string) &&\r\n      (!request.resource.data.keys().hasAny(['updatedAt']) ||\r\n        request.resource.data.updatedAt is timestamp);\r\n    }\r\n\r\n    function campaignRewardClaimFieldsAreSafe(uid) {\r\n      return request.resource.data.keys().hasOnly([\r\n        'uid',\r\n        'campaignId',\r\n        'stageId',\r\n        'previousStars',\r\n        'newStars',\r\n        'coins',\r\n        'gems',\r\n        'xp',\r\n        'status',\r\n        'createdAt',\r\n        'claimedAt',\r\n        'updatedAt',\r\n        'attemptId',\r\n        'currencyClaimed',\r\n        'xpClaimed',\r\n        'retryCount'\r\n      ]) &&\r\n      request.resource.data.uid == uid &&\r\n      request.resource.data.uid is string &&\r\n      request.resource.data.campaignId is string &&\r\n      request.resource.data.stageId is string &&\r\n      request.resource.data.previousStars is int &&\r\n      request.resource.data.previousStars >= 0 &&\r\n      request.resource.data.previousStars <= 3 &&\r\n      request.resource.data.newStars is int &&\r\n      request.resource.data.newStars >= 0 &&\r\n      request.resource.data.newStars <= 3 &&\r\n      request.resource.data.coins is int &&\r\n      request.resource.data.coins >= 0 &&\r\n      request.resource.data.gems is int &&\r\n      request.resource.data.gems >= 0 &&\r\n      request.resource.data.xp is int &&\r\n      request.resource.data.xp >= 0 &&\r\n      request.resource.data.status in ['pending', 'claimed', 'failed'] &&\r\n      request.resource.data.attemptId is string &&\r\n      request.resource.data.currencyClaimed is bool &&\r\n      request.resource.data.xpClaimed is bool &&\r\n      request.resource.data.retryCount is int &&\r\n      request.resource.data.retryCount >= 0 &&\r\n      (!request.resource.data.keys().hasAny(['createdAt']) ||\r\n        request.resource.data.createdAt is timestamp) &&\r\n      (!request.resource.data.keys().hasAny(['updatedAt']) ||\r\n        request.resource.data.updatedAt is timestamp) &&\r\n      (!request.resource.data.keys().hasAny(['claimedAt']) ||\r\n        request.resource.data.claimedAt == null ||\r\n        request.resource.data.claimedAt is timestamp);\r\n    }\r\n\r\n    function roomCoreUnchanged() {\r\n      // isPrivate / roomName / createdAt are optional on a room doc (public, unnamed\r\n      // rooms omit them). Use safe .get(...) access so a missing field does not raise\r\n      // an evaluation error (which would wrongly deny a legitimate join/update).\r\n      return request.resource.data.hostId == resource.data.hostId &&\r\n        request.resource.data.mode == resource.data.mode &&\r\n        request.resource.data.maxPlayers == resource.data.maxPlayers &&\r\n        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&\r\n        request.resource.data.get('isPrivate', false) == resource.data.get('isPrivate', false) &&\r\n        request.resource.data.get('roomName', '') == resource.data.get('roomName', '');\r\n    }\r\n\r\n    match /users/{uid} {\r\n      allow read, create, update, delete: if isOwner(uid);\r\n\r\n      match /friends/{friendUid} {\r\n        allow read, create, update, delete: if isOwner(uid);\r\n      }\r\n\r\n      match /match_history/{matchId} {\r\n        allow read, create, update, delete: if isOwner(uid);\r\n      }\r\n\r\n      match /campaignProgress/{stageId} {\r\n        allow read, create, update: if isOwner(uid);\r\n        allow delete: if false;\r\n      }\r\n\r\n      match /campaignAttempts/{attemptId} {\r\n        allow read: if isOwner(uid);\r\n        allow create: if isOwner(uid) &&\r\n          request.resource.data.uid == uid;\r\n        allow update, delete: if false;\r\n      }\r\n\r\n      match /campaignRewardClaims/{claimId} {\r\n        allow read: if isOwner(uid);\r\n        allow create, update: if isOwner(uid) &&\r\n          campaignRewardClaimFieldsAreSafe(uid);\r\n        allow delete: if false;\r\n      }\r\n    }\r\n\r\n    match /campaigns/{campaignId} {\r\n      allow read: if true;\r\n      // TODO: Seed campaign definitions through an admin backend or custom claim.\r\n      allow create, update, delete: if false;\r\n\r\n      match /stages/{stageId} {\r\n        allow read: if true;\r\n        // TODO: Seed campaign stages through an admin backend or custom claim.\r\n        allow create, update, delete: if false;\r\n      }\r\n    }\r\n\r\n    match /public_profiles/{uid} {\r\n      allow read: if signedIn();\r\n      allow create, update: if isOwner(uid) &&\r\n        request.resource.data.uid == uid &&\r\n        publicProfileFieldsAreSafe();\r\n      allow delete: if isOwner(uid);\r\n    }\r\n\r\n    match /matchmaking_queue/{uid} {\r\n      allow read, create, update, delete: if isOwner(uid);\r\n    }\r\n\r\n    match /invitations/{invitationId} {\r\n      allow read: if signedIn() && (\r\n        resource.data.toUid == request.auth.uid ||\r\n        resource.data.fromUid == request.auth.uid\r\n      );\r\n      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;\r\n      allow update: if signedIn() && (\r\n        resource.data.toUid == request.auth.uid ||\r\n        resource.data.fromUid == request.auth.uid\r\n      );\r\n      allow delete: if signedIn() && (\r\n        resource.data.toUid == request.auth.uid ||\r\n        resource.data.fromUid == request.auth.uid\r\n      );\r\n    }\r\n\r\n    match /matches/{matchId} {\r\n      allow read, create, update: if signedIn();\r\n    }\r\n\r\n    match /rooms/{roomId} {\r\n      allow read: if signedIn();\r\n\r\n      allow create: if signedIn() &&\r\n        request.resource.data.hostId == request.auth.uid &&\r\n        request.resource.data.players[request.auth.uid] != null;\r\n\r\n      allow update: if signedIn() && (\r\n        // 1. Host can make any update (start, kick, score, etc.).\r\n        resource.data.hostId == request.auth.uid ||\r\n\r\n        // 2. Existing player can update gameplay fields, but not core room identity.\r\n        (\r\n          resource.data.players[request.auth.uid] != null &&\r\n          roomCoreUnchanged()\r\n        ) ||\r\n\r\n        // 3. Any signed-in user may join (lobby or bot-slot replacement) as long\r\n        //    as they are present in the resulting players map and do not change\r\n        //    core room identity (host, mode, maxPlayers).\r\n        (\r\n          request.resource.data.players[request.auth.uid] != null &&\r\n          roomCoreUnchanged()\r\n        )\r\n      );\r\n\r\n      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;\r\n    }\r\n\r\n    match /stageLeaderboards/{leaderboardId} {\r\n      allow read: if true;\r\n      allow create, update, delete: if false;\r\n\r\n      match /scores/{uid} {\r\n        allow read: if true;\r\n        // TODO: Move campaign anti-cheat and score verification to Cloud Functions.\r\n        allow create, update: if isOwner(uid) &&\r\n          campaignLeaderboardFieldsAreSafe(uid);\r\n        allow delete: if false;\r\n      }\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-03T09:18:15.462591Z","metadata":{"services":["cloud.firestore"]}}
